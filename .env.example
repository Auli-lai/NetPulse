# NetPulse 环境变量模板
#
# 用法：
#     cp .env.example .env
#     然后把 QWEN_API_KEY 填上
#
# ⚠️ .env 里是密钥，**不要提交到版本库**（.gitignore 和 .dockerignore 里已经排除了）。
#
# 加载逻辑在 rag/config.py 的 _load_dotenv()，所有入口
# （agent/main.py、web/app.py、mcp_server/server.py）都会自动读到。
# **已存在的环境变量优先** —— 所以临时 `export` 仍然能覆盖这里的值。

# ---------------------------------------------------------------------------
# 必填：百炼 API Key
# ---------------------------------------------------------------------------
# 在 https://bailian.console.aliyun.com/ 的「API-KEY 管理」里创建。
#
# 注意：这一行**不是**"代码里写了就等于配好了"。
# os.environ.get("QWEN_API_KEY") 只是"去读"，读不到就是没有。
# 要么写在这个文件里，要么在**启动服务的那个终端**里 export。
QWEN_API_KEY=sk-在这里填你的key


# ---------------------------------------------------------------------------
# 以下都是可选的，不写就用默认值
# ---------------------------------------------------------------------------

# 生成用的模型。
# ⚠️ 端点虽然叫 "anthropic"，但后面跑的是 **Qwen**，不是 Claude。
#    填 claude-* 一定失败。
#
# ⚠️ 模型名会**下线**。原来默认的 qwen3-max 就已经不能用了，
#    报错是 `400 InvalidParameter: Model not exist.`
#    —— 那个报错听起来像"没开通"，其实是"这个名字没了"。
#
#    不确定用哪个就跑：cd rag && python check_models.py
#    它会拿你的 key 探测出**你账号真实可用**的模型清单。
#
# 实测可用（2026-10，你的账号可能不同）：qwen3.8-max / qwen3.7-max / qwen-max
# QWEN_CHAT_MODEL=qwen3.8-max

# 单次生成的最大 token
# QWEN_MAX_TOKENS=2048

# 向量化模型（走 OpenAI 兼容端点，不是 Anthropic 端点）
# QWEN_EMBEDDING_MODEL=text-embedding-v3

# 重排模型
# QWEN_RERANK_MODEL=qwen3-rerank

# 置 1 = 用哈希伪向量，不调 embedding API。
# 省钱、离线可用，但**检索质量不代表真实效果**，只能用来验证链路通不通。
# RAG_OFFLINE=1

# 长期记忆存哪
# NETPULSE_MEMORY_DIR=/path/to/memory_store

# 日志目录（web 的 netpulse://logs 资源会读它）
# NETPULSE_LOG_DIR=/path/to/logs

# 每次诊断前从长期记忆召回几条（默认 3）
# NETPULSE_RECALL_TOP_K=3
